    "class Restaurant:\n",
    "    def __init__(self):\n",
    "        self.menu_items ={\n",
    "            \"Burger\":100,\n",
    "            \"Pizza\":150,\n",
    "            \"Juice\":20 \n",
    "        }\n",
    "        self.book_tables={}\n",
    "        self.customer_orders={}\n",
    "        \n",
    "    def show_menu(self):\n",
    "        print(\"\\n-----MENU------\")\n",
    "        for item,price in self.menu_items.items():\n",
    "            print(\"-item :\",item,\"Price:\",price,\"EGP\")\n",
    "            \n",
    "    def book_table(self, customer_name, table_number):
             if customer_name in self.book_tables:
                 print("Customer already has a reservation")
                 return False

             elif table_number in self.book_tables.values():
                 print("Table is already booked")
                 return False

             elif table_number <= 0:
                 print("Invalid table number")
                 return False

             else:
                 self.book_tables[customer_name] = table_number
                 print("Table booked successfully")
                 return True\n",
    "        \n",
    "    def customer_order(self,customer_name,orders):\n",
    "        self.customer_orders[customer_name]=orders\n",
    "        \n",
    "    def show_customer_details(self,customer_name):\n",
    "        if customer_name in self.book_tables:\n",
    "            print(\"\\n-----Customer details-----\")\n",
    "            print(\"Name:\",customer_name)\n",
    "            print(\"Table Number:\",self.book_tables[customer_name])\n",
    "            \n",
    "            totalprice=0\n",
    "            print(\"orders:\")\n",
    "            for item in self.customer_orders.get(customer_name,[]):\n",
    "                price = self.menu_items[item]\n",
    "                print(\"-\",item +\":\",price,\"EGP\")\n",
    "                totalprice+=price\n",
    "            print(\"Total price : \",totalprice,\"EGP\")\n",
    "        else:\n",
    "            print(\"Cutomer not found\")\n",
    "restaurant=Restaurant()\n",
    "while True:\n",
    "    restaurant.show_menu()\n",
    "    name = input(\"Enter your name: \")\n",
    "    table = int(input(\"Enter table number: \"))\n",
    "    \n",
    "    booked = restaurant.book_table(name,table)\n",
    "    \n",
    "    if booked:\n",
    "        orders=[]\n",
    "        while True:\n",
    "            item = input(\"Enter food name or (done)to finish: \").capitalize()\n",
    "            \n",
    "            if item ==\"Done\":\n",
    "                break\n",
    "            if item in restaurant.menu_items:\n",
    "                orders.append(item)\n",
    "            else:\n",
    "                print(\"Item not found in menu\")\n",
    "        restaurant.customer_order(name,orders)\n",
    "    choice = input(\"\\nIs there another customer? (yes/no):\")\n",
    "    if choice ==\"yes\":\n",
    "        continue\n",
    "    elif choice ==\"no\":\n",
    "        break\n",
    "    else:\n",
    "        print(\"Invalid option\")\n",
    "while True:\n",
    "    name = input(\"\\nEnter customer name to see details (or exit): \")\n",
    "    if name ==\"exit\":\n",
    "        break\n",
    "    restaurant.show_customer_details(name)"
   ]
