    "user_input = [i.strip() for i in input(\"write alist separated by comma: \").split(\",\")]\n",
    "\n",
    "k = int(input(\"K = \"))\n",
    "def length(list,k):\n",
    "    l = []\n",
    "    for i in list :\n",
    "        if len(i) > k:\n",
    "            l.append(i)\n",
    "    return l\n",
    "print(length(user_input,k))"
   ]
