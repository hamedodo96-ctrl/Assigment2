    "import math\n",
    "shape = input(\"area of circle or rectangle:  \")\n",
    "def area(shape,x,y=None):\n",
    "   if shape == \"circle\".lower():\n",
    "       return (math.pi)*x**2\n",
    "   elif shape == \"rectangle\".lower():\n",
    "       return x*y\n",
    "   else:\n",
    "       return \"Invalid shape\"\n",
    "if shape == \"circle\".lower():\n",
    "    radius = float(input(\"Enter the radius: \"))\n",
    "    print(\"The area of circle:\",area(shape,radius))\n",
    "elif shape == \"rectangle\".lower():\n",
    "    length = float(input(\"Enter the length:\"))\n",
    "    width = float(input(\"Enter the width:\"))\n",
    "    print(\"The area of rectangle is:\",area(shape,length,width))\n",
    "else:\n",
    "    print(\"Invalid shape\")\n",
    "   "
   ]
  },
