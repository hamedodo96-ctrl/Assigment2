    "class Customer:\n",
    "    def __init__(self, name, age):\n",
    "        self.name = name\n",
    "        self.age = age\n",
    "    def get_name(self):\n",
    "        return self.name\n",
    "    def set_name(self, name):\n",
    "        self.name = name\n",
    "    def get_age(self):\n",
    "        return self.age\n",
    "    def set_age(self, age):\n",
    "        self.age = age\n",
    "        \n",
    "class Bike:\n",
    "    def __init__(self, name, price):\n",
    "        self.name = name\n",
    "        self.price = price\n",
    "    def get_name(self):\n",
    "        return self.name\n",
    "    def set_name(self, name):\n",
    "        self.name = name\n",
    "    def get_price(self):\n",
    "        return self.price\n",
    "    def set_price(self, price):\n",
    "        self.price = price\n",
    "        \n",
    "class MainBikeRental:\n",
    "    def __init__(self, bikes, rentals):\n",
    "        self.bikes = bikes\n",
    "        self.rentals = rentals\n",
    "    def get_bikes(self):\n",
    "        return self.bikes\n",
    "    def set_bikes(self, bikes):\n",
    "        self.bikes = bikes\n",
    "    def get_rentals(self):\n",
    "        return self.rentals\n",
    "    def set_rentals(self, rentals):\n",
    "        self.rentals = rentals\n",
    "    def requestBike(self, customer, num_of_bikes):\n",
    "        if customer.get_age() <= 6:\n",
    "            print(\"Customer must be older than 6.\")\n",
    "        elif num_of_bikes <= 0:\n",
    "            print(\"Invalid number of bikes.\")\n",
    "        elif num_of_bikes <= len(self.bikes):\n",
    "            for i in range(num_of_bikes):\n",
    "                bike = self.bikes.pop()\n",
    "                self.rentals.append(bike)\n",
    "            print(\"Bikes rented successfully.\")\n",
    "        else:\n",
    "            print(\"Wait 10 mins.\")\n",
    "\n",
    "    def returnBike(self, rentalTime, num_of_bikes):\n",
    "        if num_of_bikes <= 0 or num_of_bikes > len(self.rentals):\n",
    "            print(\"Invalid number of bikes.\")\n",
    "            return 0\n",
    "        total = rentalTime * 40\n",
    "        for i in range(num_of_bikes):\n",
    "            bike = self.rentals.pop()\n",
    "            self.bikes.append(bike)\n",
    "        return total\n",
    "    def addBike(self, bike):\n",
    "        self.bikes.append(bike)\n",
    "    def totalCost(self):\n",
    "        total = 0\n",
    "        for bike in self.bikes:\n",
    "            total += bike.get_price()\n",
    "        return total\n",
    "name = input(\"Enter your name: \")\n",
    "age = int(input(\"Enter your age: \"))\n",
    "customer = Customer(name, age)\n",
    "bikes = [\n",
    "    Bike(\"BMW\", 100),\n",
    "    Bike(\"Honda\", 80),\n",
    "    Bike(\"Yamaha\", 90) ]\n",
    "rentals = []\n",
    "shop = MainBikeRental(bikes, rentals)\n",
    "num = int(input(\"How many bikes do you want to rent? \"))\n",
    "shop.requestBike(customer, num)\n",
    "print(\"Available bikes:\", len(shop.get_bikes()))\n",
    "return_num = int(input(\"How many bikes do you want to return? \"))\n",
    "rental_time = int(input(\"Enter rental time in hours: \"))\n",
    "bill = shop.returnBike(rental_time, return_num)\n",
    "print(\"Total bill:\", bill)\n",
    "print(\"Total cost of bikes in store:\", shop.totalCost())"
   ]
  },
